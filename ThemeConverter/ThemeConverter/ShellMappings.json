{
  "//": "Visual Studio 18 Fluent tokens (Shell, ShellInternal, EditorOverride). Each value is written to the token's Background slot. 'from' is a fallback chain of VS Code keys; 'over' composites a translucent source onto the first resolvable base; 'mix' blends towards a colour; 'alpha' replaces the alpha byte. Tokens not listed inherit the fallback theme. The 'ThemeVsix Editor' category is read by the editor component packaged with the theme (ThemeVsix/ThemeEditor.cs); its alpha-1 'Enabled' token is what switches that component on.",

  "Shell&AccentFillDefault":                     { "from": ["contrastBorder", "focusBorder", "button.background"] },
  "Shell&AccentFillSecondary":                   { "from": ["contrastBorder", "focusBorder", "button.background"], "alpha": 229 },
  "Shell&AccentFillTertiary":                    { "from": ["contrastBorder", "focusBorder", "button.background"], "alpha": 204 },
  "Shell&AccentFillSenary":                      { "from": ["contrastBorder", "focusBorder", "button.background"], "alpha": 31 },
  "Shell&AccentFillAlt":                         { "from": ["contrastBorder", "focusBorder", "button.background"], "mix": { "with": "#ffffff", "amount": 0.35 } },
  "Shell&AccentTextFillPrimary":                 { "from": ["contrastBorder", "focusBorder", "button.background"], "mix": { "with": "#ffffff", "amount": 0.35 } },
  "Shell&AccentTextFillSecondary":               { "from": ["contrastBorder", "focusBorder", "button.background"], "mix": { "with": "#ffffff", "amount": 0.35 } },
  "Shell&AccentTextFillTertiary":                { "from": ["contrastBorder", "focusBorder", "button.background"] },
  "Shell&AccentFillSelectedTextBackground":      { "from": ["editor.selectionBackground"] },
  "Shell&AccentFillSelectedTextBackgroundSubtle":{ "from": ["editor.selectionBackground"], "alpha": 102 },

  "Shell&TextFillPrimary":                       { "from": ["foreground"] },
  "Shell&TextFillSecondary":                     { "from": ["sideBar.foreground", "foreground"] },
  "Shell&TextFillTertiary":                      { "from": ["descriptionForeground", "foreground"] },
  "Shell&TextFillDisabled":                      { "from": ["disabledForeground"] },
  "Shell&TextOnAccentFillPrimary":               { "from": ["statusBar.foreground", "button.foreground"] },
  "Shell&TextOnAccentFillSecondary":             { "from": ["statusBar.foreground", "button.foreground"], "alpha": 128 },

  "Shell&SolidBackgroundFillBase":               { "from": ["editor.background"] },
  "Shell&SolidBackgroundFillBaseAlt":            { "from": ["titleBar.inactiveBackground", "editorWidget.background"] },
  "Shell&SolidBackgroundFillSecondary":          { "from": ["sideBar.background", "editor.background"], "mix": { "with": "#000000", "amount": 0.3 } },
  "Shell&SolidBackgroundFillTertiary":           { "from": ["sideBar.background", "panel.background", "editor.background"] },
  "Shell&SolidBackgroundFillQuaternary":         { "from": ["menu.background", "dropdown.background", "editorWidget.background"] },
  "Shell&SolidBackgroundFillQuinary":            { "from": ["menu.background", "dropdown.background", "editorWidget.background"], "mix": { "with": "#ffffff", "amount": 0.06 } },
  "Shell&SolidBackgroundFillSenary":             { "from": ["menu.background", "dropdown.background", "editorWidget.background"], "mix": { "with": "#ffffff", "amount": 0.1 } },
  "Shell&SurfaceBackgroundFillDefault":          { "from": ["menu.background", "dropdown.background", "editorWidget.background"] },
  "Shell&SystemFillSolidNeutralBackground":      { "from": ["menu.background", "editorWidget.background"] },
  "Shell&SystemFillSolidAttentionBackground":    { "from": ["menu.background", "editorWidget.background"] },
  "Shell&CardStrokeDefaultSolid":                { "from": ["editorWidget.background", "titleBar.inactiveBackground"] },
  "Shell&ControlSolidFillDefault":               { "from": ["menu.background", "input.background"], "mix": { "with": "#ffffff", "amount": 0.15 } },
  "Shell&ControlFillActiveInput":                { "from": ["input.background"] },
  "Shell&ControlFillDefault":                    { "from": ["input.background", "dropdown.background"] },
  "Shell&ControlStrongFillDefault":              { "from": ["scrollbarSlider.background"] },
  "Shell&ControlOnImageFillSecondary":           { "from": ["editorWidget.background"] },
  "Shell&ControlOnImageFillTertiary":            { "from": ["editorWidget.background"], "mix": { "with": "#000000", "amount": 0.2 } },
  "Shell&SmokeFillInverse":                      { "from": ["editorWidget.background"], "alpha": 178 },

  "Shell&ControlStrongStrokeDefault":            { "from": ["input.border", "contrastBorder"] },
  "Shell&ControlStrokeDefault":                  { "from": ["input.border", "contrastBorder"] },
  "Shell&SurfaceStrokeDefault":                  { "from": ["contrastBorder", "widget.border", "panel.border"] },
  "Shell&DividerStrokeDefault":                  { "from": ["menu.separatorBackground", "panel.border", "contrastBorder"] },
  "Shell&SurfaceStrokeFlyout":                   { "from": ["menu.border", "editorWidget.border", "contrastBorder"] },
  "Shell&SubtleFillSecondary":                   { "from": ["menu.selectionBackground", "list.hoverBackground"] },

  "Shell&HyperlinkFillPrimary":                  { "from": ["textLink.foreground"] },
  "Shell&HyperlinkFillSecondary":                { "from": ["textLink.activeForeground", "textLink.foreground"] },
  "Shell&HyperlinkFillTertiary":                 { "from": ["textLink.foreground"], "alpha": 230 },

  "Shell&SystemFillAttention":                   { "from": ["notificationsInfoIcon.foreground", "editorInfo.foreground"] },
  "Shell&SystemFillCaution":                     { "from": ["notificationsWarningIcon.foreground", "editorWarning.foreground"] },
  "Shell&SystemFillCritical":                    { "from": ["notificationsErrorIcon.foreground", "errorForeground"] },
  "Shell&SystemFillSuccess":                     { "from": ["testing.iconPassed", "gitDecoration.addedResourceForeground"] },

  "ShellInternal&EnvironmentBackground":         { "from": ["titleBar.activeBackground", "sideBar.background"] },
  "ShellInternal&EnvironmentBody":               { "from": ["titleBar.activeBackground", "sideBar.background"] },
  "ShellInternal&EnvironmentBodyText":           { "from": ["foreground"] },
  "ShellInternal&EnvironmentBorder":             { "from": ["window.activeBorder", "contrastBorder"] },
  "ShellInternal&EnvironmentBorderInactive":     { "from": ["window.inactiveBorder", "contrastBorder"] },
  "ShellInternal&EnvironmentHeader":             { "from": ["panel.background", "editorGroupHeader.tabsBackground"] },
  "ShellInternal&EnvironmentTab":                { "from": ["editorGroupHeader.tabsBackground", "sideBar.background"] },
  "ShellInternal&EnvironmentHeaderInactive":     { "from": ["panel.background", "editorGroupHeader.tabsBackground"] },
  "ShellInternal&EnvironmentTabInactive":        { "from": ["editorGroupHeader.tabsBackground", "sideBar.background"] },
  "ShellInternal&EnvironmentLayeredBackground":  { "from": ["editorGroupHeader.tabsBackground", "sideBar.background"] },
  "ShellInternal&EnvironmentIndicator":          { "from": ["contrastBorder", "focusBorder"], "alpha": 96 },
  "ShellInternal&EnvironmentLogo":               { "from": ["contrastBorder", "focusBorder"] },
  "ShellInternal&StatusBarBackgroundFillRest":   { "from": ["statusBar.background"] },
  "ShellInternal&StatusBarTextFillRest":         { "from": ["statusBar.foreground"] },
  "ShellInternal&StatusBarTextFillDisabled":     { "from": ["statusBar.foreground"], "alpha": 93 },
  "ShellInternal&StatusBarBackgroundFillDebugging":       { "from": ["statusBar.debuggingBackground"] },
  "ShellInternal&StatusBarTextFillDebugging":             { "from": ["statusBar.debuggingForeground", "statusBar.foreground"] },
  "ShellInternal&StatusBarBackgroundFillSolutionLoading": { "from": ["statusBar.noFolderBackground", "statusBar.background"] },
  "ShellInternal&StatusBarTextFillSolutionLoading":       { "from": ["statusBar.noFolderForeground", "statusBar.foreground"] },
  "ShellInternal&StatusBarBackgroundFillBuilding":        { "from": ["editor.selectionHighlightBackground", "statusBar.background"], "alpha": 255 },
  "ShellInternal&StatusBarTextFillBuilding":              { "from": ["statusBar.foreground", "foreground"] },

  "ThemeVsix Editor&Enabled":                    { "from": ["editor.background"], "alpha": 1 },
  "ThemeVsix Editor&SelectionBackground":        { "from": ["editor.selectionBackground"], "over": ["editor.background"] },
  "ThemeVsix Editor&CaretForeground":            { "from": ["editorCursor.foreground", "editor.foreground"] },
  "ThemeVsix Editor&CaretText":                  { "from": ["editorCursor.background", "editor.background"] },
  "ThemeVsix Editor&InactiveSelectionBackground":{ "from": ["editor.inactiveSelectionBackground", "editor.selectionBackground"], "over": ["editor.background"] },

  "EditorOverride&PopupBackground":              { "from": ["editorHoverWidget.background", "editorWidget.background"] },
  "EditorOverride&PopupBorder":                  { "from": ["editorHoverWidget.border", "editorWidget.border", "contrastBorder"] },
  "EditorOverride&PopupHyperlink":               { "from": ["textLink.foreground"] },
  "EditorOverride&PopupSelectedBackground":      { "from": ["editorSuggestWidget.selectedBackground", "list.activeSelectionBackground"], "over": ["editorHoverWidget.background", "editorWidget.background"] },
  "EditorOverride&PopupSelectedText":            { "from": ["editorHoverWidget.foreground", "editorWidget.foreground", "foreground"] },
  "EditorOverride&PopupText":                    { "from": ["editorHoverWidget.foreground", "editorWidget.foreground", "foreground"] },
  "EditorOverride&PopupSubtleText":              { "from": ["descriptionForeground"], "over": ["editorHoverWidget.background", "editorWidget.background"] }
}
